{% if not fragment %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta property="og:title" content="{{ d.league }}: Week {{ d.week }}">
<meta property="og:description" content="{{ c.headline }}">
{% endif %}<title>{{ d.league }} Week {{ d.week }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=Barlow:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@500;600&display=swap">
<style>
/* Layout: navy broadcast masthead with a TRR shield, red rule, scoreboard, then one column. */
:root {
  --bg: #f4f6fb; --paper: #ffffff; --ink: #0c1a33; --muted: #55607a; --rule: #d8dde9;
  --navy: #0b2a5b; --navy-2: #071d42; --navy-ink: #ffffff; --navy-muted: #a9b8d6;
  --red: #c8102e; --red-text: #b30d28; --blue-text: #1d4f9c; --steady: #6b7590;
  --display: "Big Shoulders Display", "Arial Narrow", Impact, sans-serif;
  --body: "Barlow", "Helvetica Neue", Arial, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #060c19; --paper: #0d1628; --ink: #e9edf6; --muted: #9aa6c0; --rule: #1e2a44;
  --navy: #0a2350; --navy-2: #051633; --navy-ink: #ffffff; --navy-muted: #9fb1d4;
  --red: #e0233f; --red-text: #ff6b7d; --blue-text: #7fa8ee; --steady: #96a0b8; color-scheme: dark } }
:root[data-theme="dark"] {
  --bg: #060c19; --paper: #0d1628; --ink: #e9edf6; --muted: #9aa6c0; --rule: #1e2a44;
  --navy: #0a2350; --navy-2: #051633; --navy-ink: #ffffff; --navy-muted: #9fb1d4;
  --red: #e0233f; --red-text: #ff6b7d; --blue-text: #7fa8ee; --steady: #96a0b8; color-scheme: dark }

* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 400 1.0625rem/1.6 var(--body); }
.wrap { max-width: 48rem; margin: 0 auto; padding-inline: 16px; }

/* masthead */
.mast { background: var(--navy); color: var(--navy-ink); border-bottom: 6px solid var(--red);
  box-shadow: inset 0 -10px 0 -4px #fff; }
.mast .wrap { padding-block: 1.75rem 2rem; display: grid; gap: 1.25rem; }
.brand { display: flex; align-items: center; gap: 1rem; }
.shield { width: 64px; height: 74px; flex: none; filter: drop-shadow(0 3px 6px rgba(0,0,0,.35)); }
.brand-text { display: grid; gap: .35rem; min-width: 0; }
.issue { display: flex; flex-wrap: wrap; gap: .3rem 1rem; font: 600 .72rem/1 var(--mono);
  letter-spacing: .14em; text-transform: uppercase; color: var(--navy-muted); }
.issue b { color: #fff; background: var(--red); padding: .2rem .45rem; border-radius: 2px; font-weight: 600; }
h1.name { margin: 0; font: 900 clamp(2.4rem, 10vw, 4.6rem)/.88 var(--display); text-transform: uppercase; letter-spacing: .01em; }
.headline { margin: 0; font: 900 clamp(1.6rem, 5.5vw, 2.4rem)/1.02 var(--display); text-wrap: balance; text-transform: uppercase; }
.headline span { color: #fff; background: linear-gradient(transparent 62%, var(--red) 62%); }

/* scoreboard */
.board { display: grid; grid-template-columns: repeat(auto-fit, minmax(16.5rem, 1fr)); gap: 2px;
  background: var(--navy-2); border: 2px solid var(--navy-2); border-radius: 6px; overflow: hidden; }
.game { background: #04112b; padding: .7rem .85rem; display: grid; gap: .3rem; }
.row { display: flex; justify-content: space-between; align-items: baseline; gap: .75rem; font-family: var(--mono); }
.row .t { font-size: .82rem; letter-spacing: .06em; text-transform: uppercase; color: #8796b6;
  min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row .p { font-size: 1.15rem; font-weight: 600; font-variant-numeric: tabular-nums; color: #66749a; }
.row.w .t { color: #fff; } .row.w .p { color: #fff; text-shadow: 0 0 12px rgba(255,255,255,.35); }
.game .m { font: 500 .68rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: #ff6b7d; }

/* body */
main .wrap { padding-block: 2.25rem 3rem; display: grid; gap: 2.75rem; }
.intro { font-size: 1.22rem; line-height: 1.55; margin: 0; }
section { display: grid; gap: 1rem; }
h2 { margin: 0; font: 900 1.1rem/1 var(--display); letter-spacing: .14em; text-transform: uppercase;
  color: var(--red-text); display: flex; align-items: center; gap: .75rem; }
h2::after { content: ""; flex: 1; height: 3px; background: linear-gradient(90deg, var(--red) 0 33%, var(--rule) 33% 66%, var(--navy) 66%); opacity: .85; }

.recap { display: grid; gap: .35rem; padding-block: .25rem 1.1rem; border-bottom: 1px solid var(--rule); }
.recap:last-child { border-bottom: 0; padding-bottom: 0; }
.recap h3 { margin: 0; font: 800 1.6rem/1.08 var(--display); text-wrap: balance; text-transform: uppercase; }
.line { font: 500 .8rem/1.4 var(--mono); color: var(--muted); font-variant-numeric: tabular-nums; }
.line .wn { color: var(--blue-text); font-weight: 600; } .line .ls { color: var(--red-text); }
.recap p { margin: .2rem 0 0; max-width: 65ch; }

.teams { display: grid; gap: 12px; }
.team { background: var(--paper); border: 1px solid var(--rule); border-radius: 4px; padding: 1rem 1.1rem;
  display: grid; grid-template-columns: auto 1fr; gap: .25rem 1rem; }
.team .rk { grid-row: span 3; font: 900 2.4rem/1 var(--display); color: var(--rule); min-width: 2ch; }
.team .top { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .75rem; min-width: 0; }
.team .nm { font: 800 1.35rem/1.1 var(--display); text-transform: uppercase; }
.team .meta { font: 500 .75rem/1.3 var(--mono); color: var(--muted); font-variant-numeric: tabular-nums; }
.verdict { justify-self: start; display: inline-flex; align-items: center; gap: .4rem; font: 600 .7rem/1 var(--mono);
  letter-spacing: .1em; text-transform: uppercase; padding: .35rem .55rem; border-radius: 2px; border: 1px solid currentColor; }
.verdict.up { color: var(--blue-text); } .verdict.down { color: var(--red-text); } .verdict.steady { color: var(--steady); }
.team p { margin: 0; min-width: 0; max-width: 65ch; }

.previews { display: grid; gap: 12px; }
.preview { background: var(--navy); color: var(--navy-ink); border-radius: 4px; border-top: 4px solid var(--red); padding: 1rem 1.1rem 1.15rem; display: grid; gap: .55rem; }
.vs { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: .75rem; padding-bottom: .65rem; border-bottom: 1px solid rgba(255,255,255,.15); }
.side { display: grid; gap: .15rem; min-width: 0; }
.side.r { text-align: right; }
.pn { font: 800 1.15rem/1.05 var(--display); text-transform: uppercase; overflow-wrap: anywhere; }
.pr { font: 500 .7rem/1.2 var(--mono); color: var(--navy-muted); letter-spacing: .04em; }
.v { font: 900 1rem/1 var(--display); color: #fff; background: var(--red); padding: .35rem .5rem; border-radius: 2px; letter-spacing: .08em; }
.preview h3 { margin: 0; font: 800 1.35rem/1.1 var(--display); text-transform: uppercase; text-wrap: balance; color: #fff; }
.preview p { margin: 0; color: #d5ddee; max-width: 65ch; }

.tbl { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font: 500 .88rem/1.3 var(--mono); font-variant-numeric: tabular-nums; }
th { text-align: right; font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); font-weight: 600; padding: .5rem; border-bottom: 2px solid var(--navy); }
td { text-align: right; padding: .6rem .5rem; border-bottom: 1px solid var(--rule); white-space: nowrap; }
th:nth-child(-n+2), td:nth-child(-n+2) { text-align: left; }
td.team-c { font-family: var(--body); font-weight: 600; font-size: .98rem; white-space: normal; min-width: 10rem; }
td.team-c small { display: block; font: 500 .72rem/1.3 var(--mono); color: var(--muted); }
td.rk-c { color: var(--muted); width: 2rem; }
tr.cut td { border-bottom: 2px dashed var(--red); }
.note { font: 500 .75rem/1.5 var(--mono); color: var(--muted); margin: 0; }

.take { margin: 0; max-width: 65ch; }
.signoff { margin: 0; padding: 1.25rem 1.25rem; background: var(--red); color: #fff; border-radius: 4px;
  font: 900 clamp(1.4rem, 4.5vw, 1.9rem)/1.1 var(--display); text-transform: uppercase; text-wrap: balance; }

.archive { list-style: none; margin: 0; padding: 0; display: grid; gap: .4rem; }
.archive li { display: flex; gap: 1rem; align-items: baseline; font-size: .97rem; }
.archive .wk { font: 600 .75rem/1 var(--mono); color: var(--muted); min-width: 4.5rem; letter-spacing: .06em; text-transform: uppercase; }
a { color: var(--blue-text); text-underline-offset: 3px; }
a:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }
footer { background: var(--navy); color: var(--navy-muted); border-top: 4px solid var(--red); }
footer .wrap { padding-block: 1.25rem 2rem; font: 500 .72rem/1.6 var(--mono); }
</style>
{% if not fragment %}</head>
<body>{% endif %}
<header class="mast">
  <div class="wrap">
    <div class="brand">
      <svg class="shield" viewBox="0 0 100 116" role="img" aria-label="TRR shield">
        <path d="M50 3 L95 13 V60 C95 89 74 106 50 113 C26 106 5 89 5 60 V13 Z" fill="#ffffff"/>
        <path d="M50 9 L89 17.5 V60 C89 85 71 100 50 106.5 C29 100 11 85 11 60 V17.5 Z" fill="#0b2a5b"/>
        <path d="M11 17.5 L50 9 L89 17.5 V36 H11 Z" fill="#c8102e"/>
        <g fill="#ffffff">
          <polygon points="30,22.5 31.5,26.8 36,26.8 32.4,29.4 33.8,33.6 30,31 26.2,33.6 27.6,29.4 24,26.8 28.5,26.8"/>
          <polygon points="50,20.5 51.5,24.8 56,24.8 52.4,27.4 53.8,31.6 50,29 46.2,31.6 47.6,27.4 44,24.8 48.5,24.8"/>
          <polygon points="70,22.5 71.5,26.8 76,26.8 72.4,29.4 73.8,33.6 70,31 66.2,33.6 67.6,29.4 64,26.8 68.5,26.8"/>
        </g>
        <rect x="11" y="36" width="78" height="3" fill="#ffffff"/>
        <text x="50" y="78" text-anchor="middle" fill="#ffffff" font-family="Big Shoulders Display, Impact, sans-serif" font-weight="900" font-size="34" letter-spacing="1">TRR</text>
      </svg>
      <div class="brand-text">
        <div class="issue"><b>Week {{ d.week }}</b><span>{{ d.season }} season</span><span>Issue {{ d.week }}</span></div>
        <h1 class="name">{{ d.league }}</h1>
      </div>
    </div>
    <p class="headline"><span>{{ c.headline }}</span></p>
    <div class="board" aria-label="Week {{ d.week }} final scores">
      {% for g in d.games|sort(attribute='winner_pts', reverse=True) %}
      <div class="game">
        <div class="row w"><span class="t">{{ g.winner.name }}</span><span class="p">{{ '%.2f'|format(g.winner_pts) }}</span></div>
        <div class="row"><span class="t">{{ g.loser.name }}</span><span class="p">{{ '%.2f'|format(g.loser_pts) }}</span></div>
        <div class="m">Final · by {{ '%.2f'|format(g.margin) }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</header>

<main>
  <div class="wrap">
    <p class="intro">{{ c.intro }}</p>

    <section>
      <h2>The Games</h2>
      {% for r in recaps %}
      <article class="recap">
        <h3>{{ r.title }}</h3>
        <div class="line"><span class="wn">{{ r.g.winner.name }} {{ '%.2f'|format(r.g.winner_pts) }}</span> &nbsp;def.&nbsp; <span class="ls">{{ r.g.loser.name }} {{ '%.2f'|format(r.g.loser_pts) }}</span></div>
        <p>{{ r.body }}</p>
      </article>
      {% endfor %}
    </section>

    {% if team_reports %}
    <section>
      <h2>Team Report Cards</h2>
      <div class="teams">
        {% for r in team_reports %}
        <article class="team">
          <span class="rk">{{ r.t.rank }}</span>
          <div class="top">
            <span class="nm">{{ r.t.name }}</span>
            <span class="meta">{{ r.t.owner }} · {{ r.t.wins }}-{{ r.t.losses }}{% if r.t.ties %}-{{ r.t.ties }}{% endif %} · {{ '%.2f'|format(r.t.pf) }} PF</span>
          </div>
          <span class="verdict {{ r.trend }}">{% if r.trend == 'up' %}&#9650;{% elif r.trend == 'down' %}&#9660;{% else %}&#9644;{% endif %} {{ r.verdict }}</span>
          <p>{{ r.body }}</p>
        </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if previews %}
    <section>
      <h2>Week {{ d.week + 1 }} Preview</h2>
      <div class="previews">
        {% for p in previews %}
        <article class="preview">
          <div class="vs">
            <span class="side"><span class="pn">{{ p.u.home.name }}</span><span class="pr">{{ p.u.home.owner }} · {{ p.u.home.wins }}-{{ p.u.home.losses }}</span></span>
            <span class="v">VS</span>
            <span class="side r"><span class="pn">{{ p.u.away.name }}</span><span class="pr">{{ p.u.away.owner }} · {{ p.u.away.wins }}-{{ p.u.away.losses }}</span></span>
          </div>
          <h3>{{ p.title }}</h3>
          <p>{{ p.body }}</p>
        </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <section>
      <h2>Standings</h2>
      {% if c.power_take %}<p class="take">{{ c.power_take }}</p>{% endif %}
      <div class="tbl">
        <table>
          <thead><tr><th>#</th><th>Team</th><th>W-L</th><th>PF</th><th>PA</th><th>All-play</th><th>Strk</th></tr></thead>
          <tbody>
            {% for t in d.standings %}
            <tr{% if d.playoff_teams and loop.index == d.playoff_teams %} class="cut"{% endif %}>
              <td class="rk-c">{{ t.rank }}</td>
              <td class="team-c">{{ t.name }}<small>{{ t.owner }}</small></td>
              <td>{{ t.wins }}-{{ t.losses }}{% if t.ties %}-{{ t.ties }}{% endif %}</td>
              <td>{{ '%.2f'|format(t.pf) }}</td>
              <td>{{ '%.2f'|format(t.pa) }}</td>
              <td>{{ t.allplay }}</td>
              <td>{{ t.streak }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="note">All-play: your record if you played every team every week.{% if d.playoff_teams %} Dashed line is the playoff cut.{% endif %}</p>
    </section>

    {% if c.signoff %}<p class="signoff">{{ c.signoff }}</p>{% endif %}

    {% if archive|length > 1 %}
    <section>
      <h2>Back Issues</h2>
      <ul class="archive">
        {% for a in archive %}
        <li><span class="wk">Week {{ a.week }}</span>{% if fragment %}<span>{{ a.headline }}</span>{% else %}<a href="{{ base }}weeks/{{ a.slug }}.html">{{ a.headline }}</a>{% endif %}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
  </div>
</main>

<footer><div class="wrap">{{ d.league }} · Numbers from ESPN, opinions from a robot with no filter · Updated {{ generated }}</div></footer>
{% if not fragment %}</body>
</html>{% endif %}
