{% if not fragment %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta property="og:title" content="{{ d.league }}: Week {{ d.week }}">
<meta property="og:description" content="{{ c.headline }}">
{% endif %}<title>{{ d.league }} Week {{ d.week }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=IBM+Plex+Mono:wght@500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap">
<style>
/* Layout: a turf-green masthead with a stadium scoreboard, then one readable column. */
:root {
  --bg: #f1f3ec; --paper: #fbfcf8; --ink: #17201a; --muted: #5b665d; --rule: #d6dbd0;
  --turf: #1d4a2f; --turf-2: #163b25; --turf-ink: #eef3ea; --turf-muted: #a9c2ae;
  --bulb: #f0b347; --accent: #a95a17; --win: #2c7543; --loss: #a03d2c;
  --display: "Big Shoulders Display", "Arial Narrow", Impact, sans-serif;
  --body: "Source Serif 4", Georgia, "Times New Roman", serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #0f150f; --paper: #161e17; --ink: #e5eae1; --muted: #98a399; --rule: #29342b;
  --turf: #0e2b18; --turf-2: #0a2112; --turf-ink: #e8efe5; --turf-muted: #8fac95;
  --bulb: #f4bb55; --accent: #e59b55; --win: #63b47c; --loss: #e07a66; color-scheme: dark } }
:root[data-theme="dark"] {
  --bg: #0f150f; --paper: #161e17; --ink: #e5eae1; --muted: #98a399; --rule: #29342b;
  --turf: #0e2b18; --turf-2: #0a2112; --turf-ink: #e8efe5; --turf-muted: #8fac95;
  --bulb: #f4bb55; --accent: #e59b55; --win: #63b47c; --loss: #e07a66; color-scheme: dark }

* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 400 1.0625rem/1.6 var(--body); }
.wrap { max-width: 46rem; margin: 0 auto; padding-inline: 16px; }

/* masthead */
.mast { background: var(--turf); color: var(--turf-ink);
  background-image: repeating-linear-gradient(90deg, transparent 0 calc(10% - 1px), rgba(255,255,255,.06) calc(10% - 1px) 10%); }
.mast .wrap { padding-block: 2rem 1.75rem; display: grid; gap: 1.25rem; }
.issue { display: flex; flex-wrap: wrap; gap: .4rem 1.25rem; font: 600 .75rem/1 var(--mono);
  letter-spacing: .12em; text-transform: uppercase; color: var(--turf-muted); }
.issue b { color: var(--bulb); font-weight: 600; }
h1.name { margin: 0; font: 900 clamp(3rem, 13vw, 5.75rem)/.86 var(--display); letter-spacing: .01em; text-transform: uppercase; }
.headline { margin: 0; font: 700 clamp(1.5rem, 5vw, 2.1rem)/1.1 var(--display); text-wrap: balance; color: var(--bulb); text-transform: uppercase; letter-spacing: .02em; }

/* scoreboard */
.board { display: grid; grid-template-columns: repeat(auto-fit, minmax(16.5rem, 1fr)); gap: 2px;
  background: var(--turf-2); border: 2px solid var(--turf-2); border-radius: 6px; overflow: hidden; }
.game { background: #08130c; padding: .7rem .85rem; display: grid; gap: .3rem; }
.row { display: flex; justify-content: space-between; align-items: baseline; gap: .75rem; font-family: var(--mono); }
.row .t { font-size: .82rem; letter-spacing: .06em; text-transform: uppercase; color: #c9d6cb;
  min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row .p { font-size: 1.15rem; font-weight: 600; font-variant-numeric: tabular-nums; color: #7c8a7f; }
.row.w .t { color: #f3f6f1; } .row.w .p { color: #f4bb55; text-shadow: 0 0 10px rgba(244,187,85,.35); }
.game .m { font: 500 .68rem/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: #6f8a76; }

/* body */
main .wrap { padding-block: 2.25rem 3rem; display: grid; gap: 2.75rem; }
.intro { font-size: 1.2rem; line-height: 1.55; margin: 0; }
section { display: grid; gap: 1rem; }
h2 { margin: 0; font: 900 1.05rem/1 var(--display); letter-spacing: .14em; text-transform: uppercase;
  color: var(--accent); display: flex; align-items: center; gap: .75rem; }
h2::after { content: ""; flex: 1; height: 2px; background: var(--rule); }

.recap { display: grid; gap: .35rem; padding-block: .25rem 1.1rem; border-bottom: 1px solid var(--rule); }
.recap:last-child { border-bottom: 0; padding-bottom: 0; }
.recap h3 { margin: 0; font: 700 1.55rem/1.1 var(--display); text-wrap: balance; }
.line { font: 500 .8rem/1.4 var(--mono); color: var(--muted); font-variant-numeric: tabular-nums; }
.line .wn { color: var(--win); font-weight: 600; } .line .ls { color: var(--loss); }
.recap p { margin: .2rem 0 0; max-width: 65ch; }

.awards { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 12px; }
.award { background: var(--paper); border: 1px solid var(--rule); border-radius: 4px; padding: 1rem 1.1rem; display: grid; gap: .3rem; align-content: start; }
.award .k { font: 600 .7rem/1.2 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
.award .tm { font: 700 1.3rem/1.1 var(--display); }
.award p { margin: 0; font-size: .97rem; color: var(--muted); }

.tbl { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font: 500 .88rem/1.3 var(--mono); font-variant-numeric: tabular-nums; }
th { text-align: right; font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); font-weight: 600; padding: .5rem .5rem; border-bottom: 2px solid var(--ink); }
td { text-align: right; padding: .6rem .5rem; border-bottom: 1px solid var(--rule); white-space: nowrap; }
th:nth-child(-n+2), td:nth-child(-n+2) { text-align: left; }
td.team { font-family: var(--body); font-weight: 600; font-size: .98rem; white-space: normal; min-width: 10rem; }
td.team small { display: block; font: 500 .72rem/1.3 var(--mono); color: var(--muted); }
td.rk { color: var(--muted); width: 2rem; }
tr.cut td { border-bottom: 2px dashed var(--accent); }
.note { font: 500 .75rem/1.5 var(--mono); color: var(--muted); margin: 0; }

.take { margin: 0; max-width: 65ch; }
.signoff { margin: 0; font: 700 1.6rem/1.15 var(--display); text-transform: uppercase; text-wrap: balance; }

.archive { list-style: none; margin: 0; padding: 0; display: grid; gap: .4rem; }
.archive li { display: flex; gap: 1rem; align-items: baseline; font-size: .97rem; }
.archive .wk { font: 600 .75rem/1 var(--mono); color: var(--muted); min-width: 4.5rem; letter-spacing: .06em; text-transform: uppercase; }
a { color: var(--accent); text-underline-offset: 3px; }
a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
footer { border-top: 1px solid var(--rule); }
footer .wrap { padding-block: 1.25rem 2rem; font: 500 .72rem/1.6 var(--mono); color: var(--muted); }
</style>
{% if not fragment %}</head>
<body>{% endif %}
<header class="mast">
  <div class="wrap">
    <div class="issue"><span><b>Week {{ d.week }}</b></span><span>{{ d.season }} season</span><span>Issue {{ d.week }}</span></div>
    <h1 class="name">{{ d.league }}</h1>
    <p class="headline">{{ c.headline }}</p>
    <div class="board" aria-label="Week {{ d.week }} final scores">
      {% for g in d.games|sort(attribute='winner_pts', reverse=True) %}
      <div class="game">
        <div class="row w"><span class="t">{{ g.winner.name }}</span><span class="p">{{ '%.2f'|format(g.winner_pts) }}</span></div>
        <div class="row"><span class="t">{{ g.loser.name }}</span><span class="p">{{ '%.2f'|format(g.loser_pts) }}</span></div>
        <div class="m">Final · by {{ '%.2f'|format(g.margin) }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</header>

<main>
  <div class="wrap">
    <p class="intro">{{ c.intro }}</p>

    <section>
      <h2>The Games</h2>
      {% for r in recaps %}
      <article class="recap">
        <h3>{{ r.title }}</h3>
        <div class="line"><span class="wn">{{ r.g.winner.name }} {{ '%.2f'|format(r.g.winner_pts) }}</span> &nbsp;def.&nbsp; <span class="ls">{{ r.g.loser.name }} {{ '%.2f'|format(r.g.loser_pts) }}</span></div>
        <p>{{ r.body }}</p>
      </article>
      {% endfor %}
    </section>

    {% if c.awards %}
    <section>
      <h2>Weekly Hardware</h2>
      <div class="awards">
        {% for a in c.awards %}
        <div class="award"><span class="k">{{ a.name }}</span><span class="tm">{{ a.team }}</span><p>{{ a.blurb }}</p></div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <section>
      <h2>Standings</h2>
      {% if c.power_take %}<p class="take">{{ c.power_take }}</p>{% endif %}
      <div class="tbl">
        <table>
          <thead><tr><th>#</th><th>Team</th><th>W-L</th><th>PF</th><th>PA</th><th>All-play</th><th>Strk</th></tr></thead>
          <tbody>
            {% for t in d.standings %}
            <tr{% if d.playoff_teams and loop.index == d.playoff_teams %} class="cut"{% endif %}>
              <td class="rk">{{ t.rank }}</td>
              <td class="team">{{ t.name }}<small>{{ t.owner }}</small></td>
              <td>{{ t.wins }}-{{ t.losses }}{% if t.ties %}-{{ t.ties }}{% endif %}</td>
              <td>{{ '%.2f'|format(t.pf) }}</td>
              <td>{{ '%.2f'|format(t.pa) }}</td>
              <td>{{ t.allplay }}</td>
              <td>{{ t.streak }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="note">All-play: your record if you played every team every week.{% if d.playoff_teams %} Dashed line is the playoff cut.{% endif %}</p>
    </section>

    {% if c.signoff %}<p class="signoff">{{ c.signoff }}</p>{% endif %}

    {% if archive|length > 1 %}
    <section>
      <h2>Back Issues</h2>
      <ul class="archive">
        {% for a in archive %}
        <li><span class="wk">Week {{ a.week }}</span>{% if fragment %}<span>{{ a.headline }}</span>{% else %}<a href="{{ base }}weeks/{{ a.slug }}.html">{{ a.headline }}</a>{% endif %}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
  </div>
</main>

<footer><div class="wrap">Built from the {{ d.league }} ESPN league · Numbers from ESPN, opinions from a robot · Updated {{ generated }}</div></footer>
{% if not fragment %}</body>
</html>{% endif %}
